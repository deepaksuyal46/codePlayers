# Copy to .env.local; never commit it. Preserve your existing working Atlas URI.
MONGODB_URI=REPLACE_WITH_YOUR_ATLAS_URI
MONGODB_DB_NAME=meesho
APP_ORIGIN=http://localhost:3000
PAYMENT_MODE=demo
# 2Factor.in SMS OTP API key (not a frontend / NEXT_PUBLIC variable).
TWOFACTOR_API_KEY=REPLACE_WITH_YOUR_2FACTOR_KEY
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
# Optional provider-approved SMS template name, only if required by your account.
TWOFACTOR_TEMPLATE=
